{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "precio-al-dia",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}